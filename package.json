{
  "name": "matrix-dom",
  "private": true,
  "description": "Create element matrix using json-dom.",
  "version": "1.1.0",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "author": "Joshua Heagle",
  "license": "MPL-2.0",
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "docs": "gulp docs",
    "publish:bundle": "gulp copyFiles",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.type-tests.json",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest",
    "lint": "gulp lint"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "js-build-tools": "^8.2.0",
    "json-dom": "github:jheagle/JSON-DOM",
    "release-it": "^21.1.1",
    "standard": "^17.1.2",
    "test-filesystem": "^2.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "si-funciona": "^2.10.0"
  },
  "peerDependencies": {
    "json-dom": ">=1.4.0"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/matrix-dom.git"
  },
  "bugs": {
    "url": "https://github.com/jheagle/matrix-dom/issues"
  },
  "homepage": "https://github.com/jheagle/matrix-dom#readme",
  "standard": {
    "env": [
      "jest"
    ]
  },
  "files": [
    "dist",
    "browser"
  ],
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "esbuild": false
  }
}
